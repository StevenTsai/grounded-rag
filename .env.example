# GroundedRAG LLM 配置（参考 onco-hub 多模型 failover 模式）
# 复制为 .env 并填入实际值：cp .env.example .env

# ========== 统一覆盖（优先级最高，覆盖 provider-specific 变量） ==========
# LLM_PROVIDER=xiaomi          # 主 provider：xiaomi / deepseek / doubao
# LLM_API_KEY=sk-xxx           # 统一 API Key
# LLM_BASE_URL=                # 统一 Base URL
# LLM_MODEL=                   # 统一模型名
# LLM_TEMPERATURE=0.3
# LLM_MAX_TOKENS=4096
# LLM_TIMEOUT=30

# ========== Xiaomi MiMo ==========
# XIAOMI_API_KEY=
# XIAOMI_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
# XIAOMI_MODEL=mimo-v2.5-pro

# ========== DeepSeek ==========
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-chat

# ========== 豆包 Doubao ==========
# DOUBAO_API_KEY=
# DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# DOUBAO_MODEL=doubao-seed-2-0-pro
